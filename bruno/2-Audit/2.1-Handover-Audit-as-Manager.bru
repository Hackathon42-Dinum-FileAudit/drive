meta {
  name: 2.1 Handover Audit (as Manager) [200 OK]
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1.0/users/{{subordinate_id}}/handover/audit/
  body: none
  auth: none
}

headers {
  Accept: application/json
  Cookie: {{cookie_header}}
}

assert {
  res.status: eq 200
  res.body.departing_user.id: eq {{subordinate_id}}
  res.body.summary.total_items: isDefined
  res.body.summary.sole_owner_count: isDefined
}
