meta {
  name: 4.5 Missing Item IDs Attempt [400 Bad Request]
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1.0/users/{{subordinate_id}}/handover/transfer/
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  X-CSRFToken: {{csrf_token}}
  Cookie: {{cookie_header}}
}

body:json {
  {
    "recipient_id": "{{colleague_id}}",
    "dry_run": true
  }
}

assert {
  res.status: eq 400
  res.body.type: eq validation_error
  res.body.errors[0].attr: eq item_ids
}
